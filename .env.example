# =========================================================
# BillionBoard Environment Variables
# =========================================================
# Copy this file to .env.local for local development.
# Never commit .env.local or any file containing real secrets.
# See ENV_SETUP.md for where to paste each variable.

# -------------------------------
# Public app config
# Safe to expose in browser
# -------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_PROJECT_NAME=BillionBoard
NEXT_PUBLIC_TOKEN_TICKER=BOARD
NEXT_PUBLIC_TILE_PRICE_USD=1
NEXT_PUBLIC_TOTAL_TILES=100000
NEXT_PUBLIC_TOTAL_PIXELS=1000000000
NEXT_PUBLIC_SOLANA_NETWORK=mainnet-beta

# Browser-side RPC used by the wallet adapter (Pay USDC button, balance checks).
# Must be a NEXT_PUBLIC_ variable so the client bundle can read it.
# Use your Helius mainnet RPC URL — the same host as HELIUS_RPC_URL below.
# If unset, falls back to the public mainnet RPC which is rate-limited and will
# return 403 on wallet transactions in production.
NEXT_PUBLIC_SOLANA_RPC_URL=https://mainnet.helius-rpc.com/?api-key=YOUR_HELIUS_KEY

# Leave empty until token launch
NEXT_PUBLIC_BOARD_MINT=

# Solana USDC mint on mainnet
NEXT_PUBLIC_USDC_MINT=

# -------------------------------
# Database
# Server-side only
# -------------------------------
DATABASE_URL=

# -------------------------------
# Auth / Privy
# Server-side secret must not be NEXT_PUBLIC_
# -------------------------------
NEXT_PUBLIC_PRIVY_APP_ID=
PRIVY_APP_SECRET=

# -------------------------------
# Solana / Indexing
# Server-side only — never expose these in NEXT_PUBLIC_ variables
# (NEXT_PUBLIC_SOLANA_RPC_URL above uses the same Helius key but is intentionally
# browser-visible and scoped to read-only RPC calls from the wallet adapter)
# -------------------------------
HELIUS_API_KEY=
# Server-side RPC for API routes, cron jobs, and holder snapshots
HELIUS_RPC_URL=

# -------------------------------
# Project wallets — public addresses
# Server-side only (do not expose unnecessarily)
# -------------------------------

# TOPUP_WALLET: Receives advertiser USDC deposits.
# Top-ups are PREPAID ADVERTISER BALANCES, not revenue.
# Falls back to AD_REVENUE_WALLET for backward compatibility.
TOPUP_WALLET=

# AD_REVENUE_WALLET: Legacy alias for TOPUP_WALLET.
# Keep for backward compatibility if you had this set before.
AD_REVENUE_WALLET=

# REVENUE_WALLET: Staging wallet for EARNED revenue only.
# Only billed ad amounts and verified trading fees should move here.
# Never receives raw advertiser deposits.
REVENUE_WALLET=

# FEE_CREATOR_WALLET: Receives $BOARD trading/creator fees after token launch.
FEE_CREATOR_WALLET=

# TREASURY_WALLET: Receives 10% platform fee (management_fee_percent).
TREASURY_WALLET=

# DISTRIBUTION_WALLET: Receives 90% holder claim pool.
DISTRIBUTION_WALLET=

# MANAGEMENT_WALLET: Reserved / not used in V1.
MANAGEMENT_WALLET=

# ADMIN_WALLET: Admin access control.
ADMIN_WALLET=

# -------------------------------
# Settlement private keys
# Server-side only — NEVER expose in NEXT_PUBLIC_ variables or logs
# Format: JSON array [1,2,…64] or base64 string of the 64-byte secret key
# If missing, automated settlement is disabled (app still builds and runs).
# If set and public key doesn't match wallet address, settlement is disabled with CRITICAL warning.
# -------------------------------

# TOPUP_WALLET_PRIVATE_KEY: Signs the source→revenue transfer leg.
# Falls back to AD_REVENUE_WALLET_PRIVATE_KEY for backward compatibility.
TOPUP_WALLET_PRIVATE_KEY=

# AD_REVENUE_WALLET_PRIVATE_KEY: Legacy fallback for TOPUP_WALLET_PRIVATE_KEY.
AD_REVENUE_WALLET_PRIVATE_KEY=

# REVENUE_WALLET_PRIVATE_KEY: Signs the revenue→treasury and revenue→distribution legs.
REVENUE_WALLET_PRIVATE_KEY=

# FEE_CREATOR_WALLET_PRIVATE_KEY: Signs trading fee→revenue transfer.
# Optional — if missing, trading fee settlement stays pending/manual.
FEE_CREATOR_WALLET_PRIVATE_KEY=

# DISTRIBUTION_WALLET_PRIVATE_KEY: Signs holder claim payouts.
# Leave empty until payout flow is implemented securely.
DISTRIBUTION_WALLET_PRIVATE_KEY=

# -------------------------------
# Cloudflare R2 image storage
# Server-side only except public URL
# -------------------------------
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=

# -------------------------------
# Admin
# Server-side only
# -------------------------------
ADMIN_EMAIL=
ADMIN_PASSWORD=

# -------------------------------
# App security
# Server-side only
# -------------------------------

# SESSION_SECRET — REQUIRED in production.
# Long random string used to sign session JWTs. If missing in production,
# the app throws at startup. Generate with: openssl rand -base64 48
SESSION_SECRET=

# CRON_SECRET — Required to protect cron endpoints from public invocation.
# Vercel automatically injects CRON_SECRET into cron invocations.
# Also used to call cron endpoints manually with Bearer auth.
CRON_SECRET=

# -------------------------------
# Optional analytics
# -------------------------------
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=

# -------------------------------
# Sentry error monitoring
# Optional — app runs without these, but errors won't be captured remotely.
# Set SENTRY_DSN and NEXT_PUBLIC_SENTRY_DSN to the same DSN from your Sentry project.
# SENTRY_AUTH_TOKEN is only needed for source map upload during CI/CD builds.
# -------------------------------
# Server-side DSN (used by API routes, cron jobs, server components)
SENTRY_DSN=
# Browser-side DSN (must match SENTRY_DSN; exposed to the client bundle)
NEXT_PUBLIC_SENTRY_DSN=
# Auth token for source map upload — generate at sentry.io/settings/auth-tokens/
SENTRY_AUTH_TOKEN=
# Your Sentry org slug (from sentry.io/settings/<org>/)
SENTRY_ORG=
# Your Sentry project slug
SENTRY_PROJECT=
