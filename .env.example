# =========================================================
# BillionBoard Environment Variables
# =========================================================
# Copy this file to .env.local for local development.
# Never commit .env.local or any file containing real secrets.
# See ENV_SETUP.md for where to paste each variable.

# -------------------------------
# Public app config
# Safe to expose in browser
# -------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_PROJECT_NAME=BillionBoard
NEXT_PUBLIC_TOKEN_TICKER=BOARD
NEXT_PUBLIC_TILE_PRICE_USD=1
NEXT_PUBLIC_TOTAL_TILES=100000
NEXT_PUBLIC_TOTAL_PIXELS=1000000000
NEXT_PUBLIC_SOLANA_NETWORK=mainnet-beta

# Browser-side RPC used by the wallet adapter (Pay USDC button, balance checks).
# Must be a NEXT_PUBLIC_ variable so the client bundle can read it.
# Use your Helius mainnet RPC URL — the same host as HELIUS_RPC_URL below.
# If unset, falls back to the public mainnet RPC which is rate-limited and will
# return 403 on wallet transactions in production.
NEXT_PUBLIC_SOLANA_RPC_URL=https://mainnet.helius-rpc.com/?api-key=YOUR_HELIUS_KEY

# Leave empty until token launch
NEXT_PUBLIC_BOARD_MINT=

# Solana USDC mint on mainnet
NEXT_PUBLIC_USDC_MINT=

# -------------------------------
# Database
# Server-side only
# -------------------------------
DATABASE_URL=

# -------------------------------
# Auth / Privy
# Server-side secret must not be NEXT_PUBLIC_
# -------------------------------
NEXT_PUBLIC_PRIVY_APP_ID=
PRIVY_APP_SECRET=

# -------------------------------
# Solana / Indexing
# Server-side only — never expose these in NEXT_PUBLIC_ variables
# (NEXT_PUBLIC_SOLANA_RPC_URL above uses the same Helius key but is intentionally
# browser-visible and scoped to read-only RPC calls from the wallet adapter)
# -------------------------------
HELIUS_API_KEY=
# Server-side RPC for API routes, cron jobs, and holder snapshots
HELIUS_RPC_URL=

# -------------------------------
# Project wallets
# Server-side only
# These are public wallet addresses, but do not expose unnecessarily
# -------------------------------
ADMIN_WALLET=
FEE_CREATOR_WALLET=
AD_REVENUE_WALLET=
MANAGEMENT_WALLET=
DISTRIBUTION_WALLET=
TREASURY_WALLET=

# -------------------------------
# Claim / payout system
# Server-side only
# IMPORTANT: never expose private keys in client-side code
# For MVP, leave private key empty until payout flow is implemented securely
# -------------------------------
DISTRIBUTION_WALLET_PRIVATE_KEY=

# -------------------------------
# Cloudflare R2 image storage
# Server-side only except public URL
# -------------------------------
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=

# -------------------------------
# Admin
# Server-side only
# -------------------------------
ADMIN_EMAIL=
ADMIN_PASSWORD=

# -------------------------------
# App security
# Server-side only
# -------------------------------
SESSION_SECRET=
CRON_SECRET=

# -------------------------------
# Optional analytics
# -------------------------------
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=
