generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String   @id @default(cuid())
  email         String?  @unique
  walletAddress String?  @unique
  role          Role     @default(ADVERTISER)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  advertiserWallet AdvertiserWallet?
  topups           Topup[]
  adRentals        AdRental[]
  adCreatives      AdCreative[]
}

enum Role {
  ADVERTISER
  ADMIN
}

model AdvertiserWallet {
  id          String   @id @default(cuid())
  userId      String   @unique
  usdcBalance Decimal  @default(0) @db.Decimal(18, 6)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])
}

// tileId = col + row * BOARD_COLUMNS (400), range 0–99999. Board is 400 cols × 250 rows.
model AdRental {
  id         String       @id @default(cuid())
  userId     String
  tileId     Int
  creativeId String?
  status     RentalStatus @default(PENDING_APPROVAL)
  startDate  DateTime?
  endDate    DateTime?
  dailyRate  Decimal      @default(1.00) @db.Decimal(10, 2)
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  user          User           @relation(fields: [userId], references: [id])
  creative      AdCreative?    @relation(fields: [creativeId], references: [id])
  revenueEvents RevenueEvent[]

  @@index([userId])
  @@index([tileId])
  @@index([status])
}

enum RentalStatus {
  PENDING_APPROVAL
  ACTIVE
  EXPIRED
  REJECTED
}

enum DisplayMode {
  REPEAT
  STRETCH
}

model AdCreative {
  id          String      @id @default(cuid())
  userId      String
  imageUrl    String
  destUrl     String
  altText     String?
  displayMode DisplayMode @default(REPEAT)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  user      User       @relation(fields: [userId], references: [id])
  adRentals AdRental[]
}

model Topup {
  id               String      @id @default(cuid())
  userId           String
  amount           Decimal     @db.Decimal(18, 6)
  method           String      // 'mock' | 'usdc_solana'
  txHash           String?
  status           TopupStatus @default(PENDING)
  advertiserWallet String?
  depositWallet    String?
  txSignature      String?     @unique
  actualAmount     Decimal?    @db.Decimal(18, 6)
  rawPayload       String?
  confirmedAt      DateTime?
  expiresAt        DateTime?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([status])
  @@index([advertiserWallet])
}

enum TopupStatus {
  PENDING
  CONFIRMED
  FAILED
  EXPIRED
  UNMATCHED
  REJECTED
}

model ProcessedTransaction {
  id             String   @id @default(cuid())
  signature      String   @unique
  source         String   // 'webhook' | 'reconcile'
  amountUsdc     Decimal  @db.Decimal(18, 6)
  senderWallet   String?
  receiverWallet String?
  topupId        String?
  processedAt    DateTime @default(now())

  @@index([senderWallet])
  @@index([receiverWallet])
}

model DailyBillingRun {
  id           String   @id @default(cuid())
  runDate      DateTime @unique
  tilesCharged Int      @default(0)
  totalRevenue Decimal  @default(0) @db.Decimal(18, 6)
  status       String   @default("pending") // pending | completed | failed
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  revenueEvents      RevenueEvent[]
  distributionEpochs DistributionEpoch[]
}

model RevenueEvent {
  id           String   @id @default(cuid())
  billingRunId String
  userId       String
  rentalId     String
  amount       Decimal  @db.Decimal(18, 6)
  createdAt    DateTime @default(now())

  billingRun DailyBillingRun @relation(fields: [billingRunId], references: [id])
  rental     AdRental        @relation(fields: [rentalId], references: [id])

  @@index([billingRunId])
}

model DistributionEpoch {
  id           String      @id @default(cuid())
  billingRunId String?
  epochDate    DateTime    @unique
  totalPool    Decimal     @default(0) @db.Decimal(18, 6)
  snapshotDate DateTime?
  status       EpochStatus @default(PENDING)
  txHash       String? // TODO: real Solana distribution tx hash
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  billingRun      DailyBillingRun?  @relation(fields: [billingRunId], references: [id])
  holderSnapshots HolderSnapshot[]
  claims          Claim[]
}

enum EpochStatus {
  PENDING
  SNAPSHOT_TAKEN
  PUBLISHED
  CLOSED
}

model HolderSnapshot {
  id            String   @id @default(cuid())
  epochId       String
  walletAddress String
  tokenBalance  Decimal  @db.Decimal(18, 9)
  claimAmount   Decimal  @db.Decimal(18, 6)
  createdAt     DateTime @default(now())

  epoch DistributionEpoch @relation(fields: [epochId], references: [id])

  @@unique([epochId, walletAddress])
  @@index([walletAddress])
}

model Claim {
  id            String      @id @default(cuid())
  epochId       String
  walletAddress String
  amount        Decimal     @db.Decimal(18, 6)
  txHash        String?
  status        ClaimStatus @default(PENDING)
  claimedAt     DateTime?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  epoch DistributionEpoch @relation(fields: [epochId], references: [id])

  @@unique([epochId, walletAddress])
  @@index([walletAddress])
}

enum ClaimStatus {
  PENDING
  CLAIMED
  FAILED
}

model ExcludedWallet {
  id            String   @id @default(cuid())
  walletAddress String   @unique
  reason        String?
  createdAt     DateTime @default(now())
}

model Setting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
