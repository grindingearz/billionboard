generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String   @id @default(cuid())
  email         String?  @unique
  walletAddress String?  @unique
  role          Role     @default(ADVERTISER)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  advertiserWallet AdvertiserWallet?
  topups           Topup[]
  adRentals        AdRental[]
  adCreatives      AdCreative[]
}

enum Role {
  ADVERTISER
  ADMIN
}

model AdvertiserWallet {
  id          String   @id @default(cuid())
  userId      String   @unique
  usdcBalance Decimal  @default(0) @db.Decimal(18, 6)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])
}

// tileId = col + row * BOARD_COLUMNS (400), range 0–99999. Board is 400 cols × 250 rows.
model AdRental {
  id            String       @id @default(cuid())
  userId        String
  tileId        Int
  creativeId    String?
  status        RentalStatus @default(PENDING_APPROVAL)
  startDate     DateTime?    // activatedAt — when the ad went live
  endDate       DateTime?
  nextBillingAt DateTime?    // next time a billing charge is due
  lastBilledAt  DateTime?    // when the most recent billing charge ran
  dailyRate     Decimal      @default(1.00) @db.Decimal(10, 2)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  user          User           @relation(fields: [userId], references: [id])
  creative      AdCreative?    @relation(fields: [creativeId], references: [id])
  revenueEvents RevenueEvent[]
  billingItems  BillingItem[]

  @@index([userId])
  @@index([tileId])
  @@index([status])
  @@index([nextBillingAt])
}

enum RentalStatus {
  PENDING_APPROVAL
  ACTIVE
  EXPIRED
  SUSPENDED
  REJECTED
}

enum DisplayMode {
  REPEAT
  STRETCH
}

enum DurationType {
  DAILY
  WEEKLY
  MONTHLY
}

model AdCreative {
  id          String      @id @default(cuid())
  userId      String
  imageUrl    String
  destUrl     String
  altText      String?
  campaignName String?
  displayMode  DisplayMode @default(REPEAT)
  // Campaign fields (null = legacy per-day billing)
  durationType            DurationType?
  durationDays            Int?
  totalPrice              Decimal?      @db.Decimal(10, 2)
  prepaidAmount           Decimal?      @db.Decimal(10, 2)
  recognizedAmount        Decimal?      @db.Decimal(10, 2)
  dailyRecognizedRevenue  Decimal?      @db.Decimal(10, 2)
  campaignStartAt         DateTime?     // current cycle start (updated on renewal)
  campaignEndAt           DateTime?
  lastRecognizedAt        DateTime?
  nextRecognitionAt       DateTime?
  campaignStatus          String?       // 'ACTIVE' | 'COMPLETED' | 'EXPIRED'
  autoRenew               Boolean       @default(true)
  renewalCount            Int           @default(0)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  user                        User                        @relation(fields: [userId], references: [id])
  adRentals                   AdRental[]
  campaignRevenueRecognitions CampaignRevenueRecognition[]
  campaignRenewals            CampaignRenewal[]
  clickEvents                 ClickEvent[]
}

model CampaignRenewal {
  id           String   @id @default(cuid())
  creativeId   String
  cycleNumber  Int
  cycleStartAt DateTime
  cycleEndAt   DateTime
  totalPrice   Decimal  @db.Decimal(10, 2)
  createdAt    DateTime @default(now())

  creative AdCreative @relation(fields: [creativeId], references: [id])

  @@unique([creativeId, cycleEndAt])
  @@index([creativeId])
}

model ClickEvent {
  id         String   @id @default(cuid())
  creativeId String
  tileId     Int?
  referrer   String?
  userAgent  String?
  createdAt  DateTime @default(now())

  creative AdCreative @relation(fields: [creativeId], references: [id])

  @@index([creativeId])
  @@index([createdAt])
}

model CampaignRevenueRecognition {
  id                    String   @id @default(cuid())
  creativeId            String
  recognitionPeriodStart DateTime @db.Date
  recognitionPeriodEnd  DateTime @db.Date
  amount                Decimal  @db.Decimal(10, 2)
  revenueEventId        String?
  createdAt             DateTime @default(now())

  creative AdCreative @relation(fields: [creativeId], references: [id])

  @@unique([creativeId, recognitionPeriodStart])
  @@index([creativeId])
}

model Topup {
  id               String      @id @default(cuid())
  userId           String
  amount           Decimal     @db.Decimal(18, 6)
  method           String      // 'mock' | 'usdc_solana'
  txHash           String?
  status           TopupStatus @default(PENDING)
  advertiserWallet String?
  depositWallet    String?
  txSignature      String?     @unique
  actualAmount     Decimal?    @db.Decimal(18, 6)
  rawPayload       String?
  confirmedAt      DateTime?
  expiresAt        DateTime?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([status])
  @@index([advertiserWallet])
}

enum TopupStatus {
  PENDING
  CONFIRMED
  FAILED
  EXPIRED
  UNMATCHED
  REJECTED
}

model ProcessedTransaction {
  id             String   @id @default(cuid())
  signature      String   @unique
  source         String   // 'webhook' | 'reconcile'
  amountUsdc     Decimal  @db.Decimal(18, 6)
  senderWallet   String?
  receiverWallet String?
  topupId        String?
  processedAt    DateTime @default(now())

  @@index([senderWallet])
  @@index([receiverWallet])
}

model DailyBillingRun {
  id           String   @id @default(cuid())
  runDate      DateTime @unique
  tilesCharged Int      @default(0)
  totalRevenue Decimal  @default(0) @db.Decimal(18, 6)
  status       String   @default("pending") // pending | completed | failed
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  revenueEvents      RevenueEvent[]
  billingItems       BillingItem[]
  distributionEpochs DistributionEpoch[]
}

// Idempotency record: one row per rental per billing date.
// @@unique([rentalId, billedDate]) prevents double-billing.
model BillingItem {
  id           String   @id @default(cuid())
  billingRunId String
  rentalId     String
  billedDate   DateTime @db.Date
  amount       Decimal  @db.Decimal(10, 2)
  createdAt    DateTime @default(now())

  billingRun DailyBillingRun @relation(fields: [billingRunId], references: [id])
  rental     AdRental        @relation(fields: [rentalId], references: [id])

  @@unique([rentalId, billedDate])
  @@index([billingRunId])
}

// Revenue ledger — tracks every money movement through the platform.
model RevenueEvent {
  id           String           @id @default(cuid())
  type         RevenueEventType @default(AD_RENT_REVENUE)
  source       String           @default("billing") // 'billing' | 'webhook' | 'manual' | 'admin' | 'activation' | 'admin_approval'
  amount       Decimal          @db.Decimal(18, 6)
  currency     String           @default("USDC")
  wallet       String?
  txSignature  String?
  billingRunId String?
  userId       String?
  rentalId     String?
  epochId      String?
  metadata     Json?
  createdAt    DateTime         @default(now())

  billingRun  DailyBillingRun?   @relation(fields: [billingRunId], references: [id])
  rental      AdRental?          @relation(fields: [rentalId], references: [id])
  epoch       DistributionEpoch? @relation(fields: [epochId], references: [id])
  settlement  RevenueSettlement?

  @@index([type])
  @@index([billingRunId])
  @@index([epochId])
  @@index([txSignature])
  @@index([createdAt])
}

// Settlement tracking — one row per revenue event, tracks on-chain transfer state.
model RevenueSettlement {
  id                       String           @id @default(cuid())
  revenueEventId           String           @unique
  sourceWallet             String
  revenueWallet            String
  treasuryWallet           String
  distributionWallet       String
  amount                   Decimal          @db.Decimal(18, 6)
  treasuryAmount           Decimal          @db.Decimal(18, 6)
  distributionAmount       Decimal          @db.Decimal(18, 6)
  moveToRevenueTxSignature String?
  treasuryTxSignature      String?
  distributionTxSignature  String?
  settlementStatus         SettlementStatus @default(UNSETTLED)
  settlementError          String?
  retryCount               Int              @default(0)
  retryable                Boolean          @default(false)
  lastRetryAt              DateTime?
  nextRetryAt              DateTime?
  createdAt                DateTime         @default(now())
  settledAt                DateTime?

  revenueEvent RevenueEvent @relation(fields: [revenueEventId], references: [id])

  @@index([settlementStatus])
  @@index([retryable, nextRetryAt])
  @@index([createdAt])
}

enum SettlementStatus {
  UNSETTLED
  MOVING_TO_REVENUE
  MOVED_TO_REVENUE
  SPLITTING
  PARTIAL
  SETTLED
  FAILED
}

enum RevenueEventType {
  TOPUP_DEPOSIT
  AD_RENT_REVENUE
  TRADING_FEE_REVENUE
  MANAGEMENT_FEE
  CLAIM_POOL_ALLOCATION
  CLAIM_PAYOUT
  MANUAL_ADJUSTMENT
}

model DistributionEpoch {
  id                  String      @id @default(cuid())
  billingRunId        String?
  epochDate           DateTime    @unique
  startTime           DateTime?
  endTime             DateTime?
  // Revenue breakdown
  adRevenue           Decimal     @default(0) @db.Decimal(18, 6)
  tradingFeeRevenue   Decimal     @default(0) @db.Decimal(18, 6)
  grossPool           Decimal     @default(0) @db.Decimal(18, 6)
  managementFeePercent Decimal    @default(10) @db.Decimal(5, 2)
  managementFeeAmount Decimal     @default(0) @db.Decimal(18, 6)
  claimPoolAmount     Decimal     @default(0) @db.Decimal(18, 6)
  // Legacy field — kept for backward compat, mirrors claimPoolAmount
  totalPool           Decimal     @default(0) @db.Decimal(18, 6)
  // Snapshot
  eligibleSupply      Decimal     @default(0) @db.Decimal(18, 9)
  snapshotDate        DateTime?
  // Settled distribution funds available for claims
  settledDistributionAmount Decimal?    @db.Decimal(18, 6)
  holderCount               Int?
  claimCount                Int?
  // Status
  status              EpochStatus @default(DRAFT)
  publishedAt         DateTime?
  closedAt            DateTime?
  // Solana tx for on-chain distribution (future)
  txHash              String?
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt

  billingRun      DailyBillingRun?  @relation(fields: [billingRunId], references: [id])
  holderSnapshots HolderSnapshot[]
  claims          Claim[]
  revenueEvents   RevenueEvent[]
}

enum EpochStatus {
  // Legacy values — kept for backward compat with any existing rows
  PENDING
  SNAPSHOT_TAKEN
  // Active values
  OPEN
  PROCESSING
  FAILED
  READY_NO_TOKEN
  DRAFT
  BILLED
  SNAPSHOTTED
  PUBLISHED
  CLOSED
  CLAIMING_OPEN
  COMPLETED
}

model HolderSnapshot {
  id              String         @id @default(cuid())
  epochId         String
  walletAddress   String
  tokenBalance    Decimal        @db.Decimal(18, 9)
  eligibleBalance Decimal?       @db.Decimal(18, 9)
  claimAmount     Decimal        @db.Decimal(18, 6)
  claimedAmount   Decimal        @default(0) @db.Decimal(18, 6)
  excluded        Boolean        @default(false)
  exclusionReason String?
  status          SnapshotStatus @default(CLAIMABLE)
  txSignature     String?
  claimedAt       DateTime?
  createdAt       DateTime       @default(now())

  epoch DistributionEpoch @relation(fields: [epochId], references: [id])

  @@unique([epochId, walletAddress])
  @@index([walletAddress])
  @@index([status])
}

enum SnapshotStatus {
  CLAIMABLE
  CLAIMED
  PENDING
  VOID
}

model Claim {
  id            String      @id @default(cuid())
  epochId       String
  walletAddress String
  amount        Decimal     @db.Decimal(18, 6)
  txHash        String?
  status        ClaimStatus @default(CLAIMABLE)
  error         String?
  claimedAt     DateTime?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  epoch DistributionEpoch @relation(fields: [epochId], references: [id])

  @@unique([epochId, walletAddress])
  @@index([walletAddress])
  @@index([status])
}

enum ClaimStatus {
  CLAIMABLE
  PENDING
  CLAIMED
  FAILED
}

model ExcludedWallet {
  id            String   @id @default(cuid())
  walletAddress String   @unique
  label         String?
  reason        String?
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
}

model Setting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
