generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String   @id @default(cuid())
  email         String?  @unique
  walletAddress String?  @unique
  role          Role     @default(ADVERTISER)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  advertiserWallet AdvertiserWallet?
  topups           Topup[]
  adRentals        AdRental[]
  adCreatives      AdCreative[]
}

enum Role {
  ADVERTISER
  ADMIN
}

model AdvertiserWallet {
  id          String   @id @default(cuid())
  userId      String   @unique
  usdcBalance Decimal  @default(0) @db.Decimal(18, 6)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])
}

// tileId = col + row * BOARD_COLUMNS (400), range 0–99999. Board is 400 cols × 250 rows.
model AdRental {
  id         String       @id @default(cuid())
  userId     String
  tileId     Int
  creativeId String?
  status     RentalStatus @default(PENDING_APPROVAL)
  startDate  DateTime?
  endDate    DateTime?
  dailyRate  Decimal      @default(1.00) @db.Decimal(10, 2)
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  user          User           @relation(fields: [userId], references: [id])
  creative      AdCreative?    @relation(fields: [creativeId], references: [id])
  revenueEvents RevenueEvent[]
  billingItems  BillingItem[]

  @@index([userId])
  @@index([tileId])
  @@index([status])
}

enum RentalStatus {
  PENDING_APPROVAL
  ACTIVE
  EXPIRED
  REJECTED
}

enum DisplayMode {
  REPEAT
  STRETCH
}

model AdCreative {
  id          String      @id @default(cuid())
  userId      String
  imageUrl    String
  destUrl     String
  altText     String?
  displayMode DisplayMode @default(REPEAT)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  user      User       @relation(fields: [userId], references: [id])
  adRentals AdRental[]
}

model Topup {
  id               String      @id @default(cuid())
  userId           String
  amount           Decimal     @db.Decimal(18, 6)
  method           String      // 'mock' | 'usdc_solana'
  txHash           String?
  status           TopupStatus @default(PENDING)
  advertiserWallet String?
  depositWallet    String?
  txSignature      String?     @unique
  actualAmount     Decimal?    @db.Decimal(18, 6)
  rawPayload       String?
  confirmedAt      DateTime?
  expiresAt        DateTime?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([status])
  @@index([advertiserWallet])
}

enum TopupStatus {
  PENDING
  CONFIRMED
  FAILED
  EXPIRED
  UNMATCHED
  REJECTED
}

model ProcessedTransaction {
  id             String   @id @default(cuid())
  signature      String   @unique
  source         String   // 'webhook' | 'reconcile'
  amountUsdc     Decimal  @db.Decimal(18, 6)
  senderWallet   String?
  receiverWallet String?
  topupId        String?
  processedAt    DateTime @default(now())

  @@index([senderWallet])
  @@index([receiverWallet])
}

model DailyBillingRun {
  id           String   @id @default(cuid())
  runDate      DateTime @unique
  tilesCharged Int      @default(0)
  totalRevenue Decimal  @default(0) @db.Decimal(18, 6)
  status       String   @default("pending") // pending | completed | failed
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  revenueEvents      RevenueEvent[]
  billingItems       BillingItem[]
  distributionEpochs DistributionEpoch[]
}

// Idempotency record: one row per rental per billing date.
// @@unique([rentalId, billedDate]) prevents double-billing.
model BillingItem {
  id           String   @id @default(cuid())
  billingRunId String
  rentalId     String
  billedDate   DateTime @db.Date
  amount       Decimal  @db.Decimal(10, 2)
  createdAt    DateTime @default(now())

  billingRun DailyBillingRun @relation(fields: [billingRunId], references: [id])
  rental     AdRental        @relation(fields: [rentalId], references: [id])

  @@unique([rentalId, billedDate])
  @@index([billingRunId])
}

// Revenue ledger — tracks every money movement through the platform.
model RevenueEvent {
  id           String           @id @default(cuid())
  type         RevenueEventType @default(AD_RENT_REVENUE)
  source       String           @default("billing") // 'billing' | 'webhook' | 'manual' | 'admin'
  amount       Decimal          @db.Decimal(18, 6)
  currency     String           @default("USDC")
  wallet       String?
  txSignature  String?
  billingRunId String?
  userId       String?
  rentalId     String?
  epochId      String?
  metadata     Json?
  createdAt    DateTime         @default(now())

  billingRun DailyBillingRun?   @relation(fields: [billingRunId], references: [id])
  rental     AdRental?          @relation(fields: [rentalId], references: [id])
  epoch      DistributionEpoch? @relation(fields: [epochId], references: [id])

  @@index([type])
  @@index([billingRunId])
  @@index([epochId])
  @@index([txSignature])
  @@index([createdAt])
}

enum RevenueEventType {
  TOPUP_DEPOSIT
  AD_RENT_REVENUE
  TRADING_FEE_REVENUE
  MANAGEMENT_FEE
  CLAIM_POOL_ALLOCATION
  CLAIM_PAYOUT
  MANUAL_ADJUSTMENT
}

model DistributionEpoch {
  id                  String      @id @default(cuid())
  billingRunId        String?
  epochDate           DateTime    @unique
  startTime           DateTime?
  endTime             DateTime?
  // Revenue breakdown
  adRevenue           Decimal     @default(0) @db.Decimal(18, 6)
  tradingFeeRevenue   Decimal     @default(0) @db.Decimal(18, 6)
  grossPool           Decimal     @default(0) @db.Decimal(18, 6)
  managementFeePercent Decimal    @default(10) @db.Decimal(5, 2)
  managementFeeAmount Decimal     @default(0) @db.Decimal(18, 6)
  claimPoolAmount     Decimal     @default(0) @db.Decimal(18, 6)
  // Legacy field — kept for backward compat, mirrors claimPoolAmount
  totalPool           Decimal     @default(0) @db.Decimal(18, 6)
  // Snapshot
  eligibleSupply      Decimal     @default(0) @db.Decimal(18, 9)
  snapshotDate        DateTime?
  // Status
  status              EpochStatus @default(DRAFT)
  publishedAt         DateTime?
  closedAt            DateTime?
  // Solana tx for on-chain distribution (future)
  txHash              String?
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt

  billingRun      DailyBillingRun?  @relation(fields: [billingRunId], references: [id])
  holderSnapshots HolderSnapshot[]
  claims          Claim[]
  revenueEvents   RevenueEvent[]
}

enum EpochStatus {
  // Legacy values — kept for backward compat with any existing rows
  PENDING
  SNAPSHOT_TAKEN
  // Active values
  DRAFT
  BILLED
  SNAPSHOTTED
  PUBLISHED
  CLOSED
}

model HolderSnapshot {
  id            String         @id @default(cuid())
  epochId       String
  walletAddress String
  tokenBalance  Decimal        @db.Decimal(18, 9)
  claimAmount   Decimal        @db.Decimal(18, 6)
  claimedAmount Decimal        @default(0) @db.Decimal(18, 6)
  status        SnapshotStatus @default(CLAIMABLE)
  txSignature   String?
  claimedAt     DateTime?
  createdAt     DateTime       @default(now())

  epoch DistributionEpoch @relation(fields: [epochId], references: [id])

  @@unique([epochId, walletAddress])
  @@index([walletAddress])
  @@index([status])
}

enum SnapshotStatus {
  CLAIMABLE
  CLAIMED
  PENDING
  VOID
}

model Claim {
  id            String      @id @default(cuid())
  epochId       String
  walletAddress String
  amount        Decimal     @db.Decimal(18, 6)
  txHash        String?
  status        ClaimStatus @default(PENDING)
  claimedAt     DateTime?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  epoch DistributionEpoch @relation(fields: [epochId], references: [id])

  @@unique([epochId, walletAddress])
  @@index([walletAddress])
}

enum ClaimStatus {
  PENDING
  CLAIMED
  FAILED
}

model ExcludedWallet {
  id            String   @id @default(cuid())
  walletAddress String   @unique
  label         String?
  reason        String?
  createdAt     DateTime @default(now())
}

model Setting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
